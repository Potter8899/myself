<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>พอตเตอร์ (Potter) | Portfolio</title>
<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#0c0d12;--surface:#171921;--text:#f4f4f6;--muted:#9a9aa5;--red:#e0162f;--cyan:#22d3ee;--line:#272a34;color-scheme:dark;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#f6f6f8;--surface:#fff;--text:#111116;--muted:#5d5d68;--red:#e11d38;--cyan:#0891b2;--line:#d9d9e0;color-scheme:light}}
:root[data-theme="dark"]{--bg:#0c0d12;--surface:#171921;--text:#f4f4f6;--muted:#9a9aa5;--red:#ff2d46;--cyan:#22d3ee;--line:#2a2a33}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:radial-gradient(ellipse 55% 45% at 50% -8%,rgba(130,140,185,.25),transparent 70%) fixed,var(--bg);color:var(--text);font-family:"Prompt","Noto Sans Thai",system-ui,sans-serif;line-height:1.7;min-height:100vh}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:20}
#bg{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
.wrap{position:relative;z-index:1;max-width:900px;margin:0 auto;padding:0 20px}
:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
.hero{display:grid;grid-template-columns:1fr 230px;gap:28px;align-items:center;padding:44px 0 28px;position:relative}
.hero-card{width:100%;justify-self:end}
.web{position:absolute;right:-30px;top:-30px;width:340px;opacity:.35;pointer-events:none;z-index:-1}
.web path{fill:none;stroke:var(--red);stroke-width:1.2;stroke-dasharray:400;stroke-dashoffset:400;animation:draw 2.4s ease-out forwards}
@keyframes draw{to{stroke-dashoffset:0}}
@media (max-width:640px){.hero{grid-template-columns:1fr}.hero-card{max-width:210px;justify-self:start}}
.hero .hi{color:var(--muted);margin:0}
h1{font-size:clamp(3.2rem,15vw,7rem);line-height:1.05;margin:0 0 8px;font-weight:800;letter-spacing:-.02em}
h1 span{display:inline-block;background:var(--red);color:#fff;padding:0 .18em;transform:skew(-6deg);animation:pop .7s cubic-bezier(.2,.9,.3,1.2) both;box-shadow:0 0 40px rgba(255,45,70,.45)}
@keyframes pop{from{transform:skew(-6deg) translateX(-40px);opacity:0}}
.type{font-size:1.15rem;color:var(--cyan);min-height:1.8em;margin:0}
.type::after{content:"|";animation:blink 1s steps(2) infinite}
@keyframes blink{50%{opacity:0}}
.tabs{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;display:flex;gap:6px;overflow-x:auto;padding:10px 0;background:var(--bg);border-bottom:2px solid var(--line)}
.tab{flex:none;padding:9px 20px;border:2px solid var(--line);border-radius:6px;background:var(--surface);color:var(--muted);font:600 .98rem "Prompt",sans-serif;cursor:pointer;transition:.2s}
.tab:hover{color:var(--text);border-color:var(--cyan)}
.tab[aria-selected="true"]{background:var(--red);border-color:var(--red);color:#fff;box-shadow:0 0 18px rgba(255,45,70,.5)}
.panel{padding:36px 0 60px;animation:in .45s ease both}
.panel[hidden]{display:none}
@keyframes in{from{opacity:0;transform:translateY(18px)}}
h2{font-size:1.8rem;margin:0 0 22px;padding-left:14px;border-left:6px solid var(--cyan)}
.muted{color:var(--muted)}
.facts{display:grid;gap:10px;max-width:520px;margin:0 0 20px}
.facts div{padding:14px 18px;background:var(--surface);border-left:4px solid var(--red)}
.facts small{display:block;color:var(--muted)}.facts b{font-size:1.1rem}
.proj{list-style:none;margin:0;padding:0}
.proj li{display:grid;grid-template-columns:1fr auto;gap:2px 16px;padding:18px 12px;border-top:1px solid var(--line);transition:.2s}
.proj li:hover{background:var(--surface);padding-left:22px;border-left:4px solid var(--red)}
.proj b{font-size:1.1rem}.proj p{grid-column:1;margin:0;color:var(--muted)}
.proj em{font-style:normal;color:var(--cyan);font-size:.9rem;grid-row:1;grid-column:2;align-self:center}
.bar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:22px}
.btn{padding:9px 20px;border:2px solid var(--cyan);color:var(--cyan);border-radius:4px;background:none;font:600 .95rem "Prompt",sans-serif;cursor:pointer;text-decoration:none;display:inline-block}
.btn:hover{background:var(--cyan);color:#000}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:20px}
.card{position:relative;aspect-ratio:3/4;border:0;padding:0;border-radius:12px;overflow:hidden;cursor:pointer;background:var(--surface);
transform:perspective(700px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) scale(var(--s,1));transition:transform .15s ease-out,box-shadow .2s;box-shadow:0 8px 24px rgba(0,0,0,.4);animation:in .5s ease both}
.card:hover{--s:1.05;box-shadow:0 18px 40px rgba(255,45,70,.35),0 0 0 2px var(--cyan)}
.card img{width:100%;height:100%;object-fit:cover;display:block;pointer-events:none}
.card i{position:absolute;inset:0;background:radial-gradient(circle at var(--mx,50%) var(--my,50%),rgba(255,255,255,.35),transparent 55%);opacity:0;transition:opacity .2s;pointer-events:none}
.card:hover i{opacity:1}
.card .tag{position:absolute;left:8px;bottom:8px;padding:2px 10px;background:rgba(0,0,0,.65);color:#fff;font-size:.8rem;border-radius:20px}
#drop{position:fixed;inset:0;z-index:50;display:none;place-items:center;background:rgba(10,10,12,.86);border:4px dashed var(--cyan);font-size:1.8rem;font-weight:800;color:var(--cyan)}
#drop.on{display:grid}
#lb{position:fixed;inset:0;z-index:60;display:none;place-items:center;background:rgba(0,0,0,.9);cursor:zoom-out;padding:20px}
#lb.on{display:grid}
#lb img{max-width:100%;max-height:100%;border-radius:8px;box-shadow:0 0 60px rgba(34,211,238,.35);animation:zoom .3s cubic-bezier(.2,.9,.3,1.2)}
@keyframes zoom{from{transform:scale(.7);opacity:0}}
.code{background:var(--surface);border:1px solid var(--line);border-radius:6px;overflow:hidden}
.code header{display:flex;justify-content:space-between;align-items:center;padding:8px 8px 8px 16px;border-bottom:1px solid var(--line);color:var(--muted);font-size:.9rem}
.code .btn{padding:3px 14px;font-size:.9rem}
pre{margin:0;padding:16px;overflow-x:auto;font:.9rem/1.6 ui-monospace,Consolas,monospace;color:var(--cyan)}
.services{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
.services div{padding:18px;background:var(--surface);border-top:3px solid var(--red);transition:transform .2s}
.services div:hover{transform:translateY(-6px)}
.services div:nth-child(even){border-top-color:var(--cyan)}
.services b{display:block}.services span{color:var(--muted);font-size:.95rem}
.links a{display:inline-block;margin:0 10px 10px 0}
footer{position:relative;z-index:1;text-align:center;padding:20px 20px 40px;color:var(--muted);font-size:.9rem}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<canvas id="bg" aria-hidden="true"></canvas>
<div id="drop">วางรูปที่นี่เพื่อเพิ่มในแกลเลอรี</div>
<div id="lb" role="dialog" aria-label="ดูรูปเต็ม"><img alt=""></div>

<div class="wrap">
<header class="hero"><svg class="web" viewBox="0 0 200 200" aria-hidden="true"><path d="M200 0L100 100M200 0L200 100M200 0L100 0M200 0L160 120M200 0L40 40M200 0L120 160"/><path d="M180 0Q170 50 200 80M140 0Q130 80 200 130M100 0Q90 110 200 170M60 0Q60 150 200 200"/></svg>
  <div>
  <p class="hi">สวัสดีครับ ผมชื่อเล่น</p>
  <h1><span>พอตเตอร์</span></h1>
  <p class="type" id="type" aria-label="นักพัฒนาเว็บ แอป และมอดเกม"></p>
  </div>
  <button class="card hero-card" id="heroCard" type="button"><img alt="พอตเตอร์ใส่หน้ากากสไปเดอร์แมน"><i></i></button>
</header>

<div class="tabs" role="tablist" aria-label="เมนู">
  <button class="tab" role="tab" data-t="about">เกี่ยวกับ</button>
  <button class="tab" role="tab" data-t="projects">ผลงาน</button>
  <button class="tab" role="tab" data-t="gallery">แกลเลอรี</button>
  <button class="tab" role="tab" data-t="code">แจกโค้ด</button>
  <button class="tab" role="tab" data-t="hire">รับงาน</button>
  <button class="tab" role="tab" data-t="contact">ติดต่อ</button>
</div>

<main>
<section class="panel" id="about" role="tabpanel">
  <h2>เกี่ยวกับผม</h2>
  <div class="facts">
    <div><small>ชื่อ</small><b>พัฒนพล ภักดีอำนาจ (พอตเตอร์)</b></div>
    <div><small>โรงเรียน</small><b>แก่นนครวิทยาลัย</b></div>
    <div><small>ชั้นเรียน</small><b>มัธยมศึกษาปีที่ 2</b></div>
  </div>
  <p class="muted">ชอบทำเว็บ แอป และมอดเกม ลงมือทำจริงแล้วแบ่งโค้ดให้คนอื่นใช้ต่อ</p>
</section>

<section class="panel" id="projects" role="tabpanel" hidden>
  <h2>ผลงานที่เคยทำ</h2>
  <ul class="proj">
    <li><b>SHARK Shop</b><em>เว็บ · HTML/JS</em><p>เว็บร้านค้าออนไลน์ โทนม่วง-ฟ้า รองรับ 2 ภาษา มีระบบเติมเงิน</p></li>
    <li><b>AI Badminton Referee</b><em>Android · Kotlin</em><p>แอปกรรมการแบดมินตันด้วยกล้องและ AI นับคะแนนอัตโนมัติ</p></li>
    <li><b>Potter Notify Bridge</b><em>Android + Windows</em><p>ส่งแจ้งเตือนจากมือถือไปแสดงบนคอมผ่านเครือข่ายในบ้าน</p></li>
    <li><b>มอด Minecraft (Forge)</b><em>Java</em><p>มอดร้านค้า มอดกู้คืนกระจก และมอด NPC สำหรับเซิร์ฟเวอร์</p></li>
  </ul>
</section>

<section class="panel" id="gallery" role="tabpanel" hidden>
  <h2>แกลเลอรี</h2>
  <div class="bar">
    <label class="btn">เลือกรูป<input type="file" id="file" accept="image/*" multiple hidden></label>
    <span class="muted">หรือลากรูปมาวางที่หน้าเว็บได้เลย · เอาเมาส์ชี้การ์ดเพื่อเอียง · กดเพื่อดูเต็ม</span>
  </div>
  <div class="grid" id="grid"></div>
</section>

<section class="panel" id="code" role="tabpanel" hidden>
  <h2>แจกโค้ด</h2>
  <div class="code">
    <header><span>ตัวอย่างโค้ด</span><button class="btn" id="copy" type="button">คัดลอก</button></header>
<pre id="snippet">// ตัวอย่าง: หน่วงเวลาแล้วทำงานต่อ
const wait = ms => new Promise(r => setTimeout(r, ms));
await wait(1000);
console.log("เสร็จแล้ว");</pre>
  </div>
  <p class="muted">ลิงก์ GitHub และไฟล์ ZIP จะมาใส่ตรงนี้</p>
</section>

<section class="panel" id="hire" role="tabpanel" hidden>
  <h2>รับงานอะไรบ้าง</h2>
  <div class="services">
    <div><b>ทำเว็บไซต์</b><span>เว็บร้านค้า เว็บแนะนำตัว</span></div>
    <div><b>มอด Minecraft</b><span>Forge ตามที่เซิร์ฟเวอร์ต้องการ</span></div>
    <div><b>แอป Android / Windows</b><span>เครื่องมือเฉพาะทาง</span></div>
    <div><b>สคริปต์และบอท</b><span>Python, แจ้งเตือน Discord</span></div>
  </div>
</section>

<section class="panel" id="contact" role="tabpanel" hidden>
  <h2>ติดต่อ</h2>
  <div class="links"><a class="btn" href="#contact">Discord</a><a class="btn" href="#contact">GitHub</a><a class="btn" href="#contact">Facebook</a></div>
  <p class="muted">ใส่ลิงก์จริงทีหลัง</p>
</section>
</main>
</div>
<footer>© 2026 พอตเตอร์</footer>

<script>
(function(){
var reduce=matchMedia("(prefers-reduced-motion: reduce)").matches;
/* ---- tabs ---- */
var tabs=[].slice.call(document.querySelectorAll(".tab")),panels=[].slice.call(document.querySelectorAll(".panel")),ids=tabs.map(function(t){return t.dataset.t});
function show(id){
  if(ids.indexOf(id)<0)id="about";
  tabs.forEach(function(t){var on=t.dataset.t===id;t.setAttribute("aria-selected",on);t.tabIndex=on?0:-1});
  panels.forEach(function(p){p.hidden=p.id!==id});
}
tabs.forEach(function(t,i){
  t.onclick=function(){location.hash=t.dataset.t};
  t.onkeydown=function(e){var n=e.key==="ArrowRight"?1:e.key==="ArrowLeft"?-1:0;if(n){var k=tabs[(i+n+tabs.length)%tabs.length];k.focus();location.hash=k.dataset.t}};
});
addEventListener("hashchange",function(){show(location.hash.slice(1))});
show(location.hash.slice(1));

/* ---- typing ---- */
var txt="นักพัฒนาเว็บ แอป และมอดเกม",el=document.getElementById("type"),n=0;
if(reduce){el.textContent=txt}else{var iv=setInterval(function(){el.textContent=txt.slice(0,++n);if(n>=txt.length)clearInterval(iv)},70)}

/* ---- gallery ---- */
var IMAGES=["data:image/jpeg;base64,"]; // เพิ่มรูปถาวรต่อท้ายได้
var hc=document.getElementById("heroCard"),hs=IMAGES[0];hc.querySelector("img").src=hs;tilt(hc);hc.onclick=function(){lbi.src=hs;lb.classList.add("on")};
var grid=document.getElementById("grid"),lb=document.getElementById("lb"),lbi=lb.querySelector("img"),hasReal=false;
function tilt(b){
  b.addEventListener("pointermove",function(e){
    var r=b.getBoundingClientRect(),x=(e.clientX-r.left)/r.width,y=(e.clientY-r.top)/r.height;
    b.style.setProperty("--rx",((.5-y)*20)+"deg");b.style.setProperty("--ry",((x-.5)*20)+"deg");
    b.style.setProperty("--mx",x*100+"%");b.style.setProperty("--my",y*100+"%")});
  b.addEventListener("pointerleave",function(){b.style.setProperty("--rx","0deg");b.style.setProperty("--ry","0deg")});
}
function sample(i){var c=[["#ff2d46","#22d3ee"],["#22d3ee","#111"],["#ff2d46","#111"]][i];
  return "data:image/svg+xml,"+encodeURIComponent("<svg xmlns='http://www.w3.org/2000/svg' width='600' height='800'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='"+c[0]+"'/><stop offset='1' stop-color='"+c[1]+"'/></linearGradient></defs><rect width='600' height='800' fill='url(#g)'/><text x='300' y='420' font-size='64' fill='white' text-anchor='middle' font-family='sans-serif'>Potter</text></svg>")}
function addCard(src,isSample){
  var b=document.createElement("button"),im=new Image(),g=document.createElement("i");
  b.className="card";b.type="button";if(isSample)b.dataset.sample="1";
  im.src=src;im.alt="รูปในแกลเลอรี";b.appendChild(im);b.appendChild(g);
  if(isSample){var t=document.createElement("span");t.className="tag";t.textContent="ตัวอย่าง";b.appendChild(t)}
  tilt(b);
  b.onclick=function(){lbi.src=src;lb.classList.add("on")};
  grid.insertBefore(b,grid.firstChild);
}
function addFiles(files){
  var imgs=[].filter.call(files,function(f){return /^image\//.test(f.type)});
  if(!imgs.length)return;
  if(!hasReal){hasReal=true;[].slice.call(grid.querySelectorAll("[data-sample]")).forEach(function(s){s.remove()})}
  imgs.forEach(function(f){addCard(URL.createObjectURL(f))});
  location.hash="gallery";
}
if(IMAGES.length){hasReal=true;IMAGES.forEach(function(s){addCard(s)})}else{[2,1,0].forEach(function(i){addCard(sample(i),true)})}
lb.onclick=function(){lb.classList.remove("on")};
addEventListener("keydown",function(e){if(e.key==="Escape")lb.classList.remove("on")});
document.getElementById("file").onchange=function(e){addFiles(e.target.files);e.target.value=""};
var drop=document.getElementById("drop");
["dragenter","dragover"].forEach(function(ev){addEventListener(ev,function(e){e.preventDefault();drop.classList.add("on")})});
addEventListener("dragleave",function(e){if(!e.relatedTarget)drop.classList.remove("on")});
addEventListener("drop",function(e){e.preventDefault();drop.classList.remove("on");addFiles(e.dataTransfer.files)});

/* ---- copy ---- */
var cp=document.getElementById("copy"),sn=document.getElementById("snippet");
function done(){cp.textContent="คัดลอกแล้ว";setTimeout(function(){cp.textContent="คัดลอก"},1500)}
function fb(){try{var r=document.createRange();r.selectNodeContents(sn);var s=getSelection();s.removeAllRanges();s.addRange(r);document.execCommand("copy");done()}catch(e){}}
cp.onclick=function(){try{navigator.clipboard.writeText(sn.textContent).then(done,fb)}catch(e){fb()}};

/* ---- background particles ---- */
var cv=document.getElementById("bg"),cx=cv.getContext("2d"),W,H,P=[],mouse={x:-999,y:-999};
function size(){var d=devicePixelRatio||1;W=innerWidth;H=innerHeight;cv.width=W*d;cv.height=H*d;cx.setTransform(d,0,0,d,0,0)}
size();addEventListener("resize",size);
addEventListener("pointermove",function(e){mouse.x=e.clientX;mouse.y=e.clientY});
for(var i=0;i<(W<600?30:60);i++)P.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.5,vy:(Math.random()-.5)*.5,c:i%2?"224,22,47":"34,211,238"});
function draw(){
  cx.clearRect(0,0,W,H);
  P.forEach(function(p,i){
    p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>W)p.vx*=-1;if(p.y<0||p.y>H)p.vy*=-1;
    cx.fillStyle="rgba("+p.c+",.8)";cx.beginPath();cx.arc(p.x,p.y,2,0,6.3);cx.fill();
    for(var j=i+1;j<P.length;j++){var q=P[j],d=Math.hypot(p.x-q.x,p.y-q.y);
      if(d<120){cx.strokeStyle="rgba("+p.c+","+(.25*(1-d/120))+")";cx.beginPath();cx.moveTo(p.x,p.y);cx.lineTo(q.x,q.y);cx.stroke()}}
    var m=Math.hypot(p.x-mouse.x,p.y-mouse.y);
    if(m<150){cx.strokeStyle="rgba(255,255,255,"+(.3*(1-m/150))+")";cx.beginPath();cx.moveTo(p.x,p.y);cx.lineTo(mouse.x,mouse.y);cx.stroke()}
  });
  if(!reduce)requestAnimationFrame(draw);
}
draw();
})();
</script>
</body>
</html>
